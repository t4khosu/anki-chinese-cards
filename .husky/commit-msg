VALID_TAGS="feat|fix|refactor|chore|perf|ci|ops|build|docs|style|revert|test"
MSG="$(head -1 "$1")"
if ! echo "$MSG" | grep -qE "^($VALID_TAGS): .+"; then
  echo "ERROR: Commit message must start with a valid tag."
  echo "Valid tags: feat, fix, refactor, chore, perf, ci, ops, build, docs, style, revert, test"
  echo "Format: <tag>: <description>"
  echo "Got: $MSG"
  exit 1
fi
